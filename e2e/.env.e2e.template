E2E_ADMIN_EMAIL=test-admin@example.com
E2E_ADMIN_PASSWORD=

# One Keycloak user per parallel worker. Worker 0 is always required;
# add more (E2E_USER_EMAIL_1, _2, ...) and bump E2E_WORKERS to run in
# parallel. Each worker must have a distinct Keycloak user — tests
# clean up their user's DB rows in beforeEach, so sharing causes races.
E2E_WORKERS=1
E2E_USER_EMAIL_0=user-0@example.com
E2E_USER_PASSWORD_0=
# E2E_USER_EMAIL_1=user-1@example.com
# E2E_USER_PASSWORD_1=
# E2E_USER_EMAIL_2=user-2@example.com
# E2E_USER_PASSWORD_2=
# E2E_USER_EMAIL_3=user-3@example.com
# E2E_USER_PASSWORD_3=

API_BASE_URL=http://127.0.0.1:8080/api
APP_BASE_URL=http://127.0.0.1:5173

DATABASE_URL=postgresql://membership:secret@127.0.0.1:5433/membership
