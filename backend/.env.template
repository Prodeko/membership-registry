RUST_LOG=debug
DATABASE_URL=postgres://membership:secret@localhost:5433/membership?sslmode=disable
TEST_DATABASE_URL=postgres://membership:secret@localhost:5433/membership?sslmode=disable

# On linux (WSL) you can't bind to ports below 1024 without
# net_bind_service capability or root.
# Port 80 would cause tokio::net::TcpListener::bind(PORT) to fail with
# Os { code: 13, kind: PermissionDenied, message: "Permission denied" }
PORT=8080
FRONTEND_URL=http://127.0.0.1:5173

# Auth0 configuration
# AUTH0_DOMAIN is your Auth0 tenant domain (e.g., your-tenant.auth0.com or your-tenant.us.auth0.com)
AUTH0_DOMAIN=

# AUTH0_CLIENT_ID and AUTH0_CLIENT_SECRET are from your Auth0 application
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# OAUTH_REDIRECT_URL is the callback URL after authentication
OAUTH_REDIRECT_URL=http://127.0.0.1:5173/auth/callback

# AUTH0_AUDIENCE is optional, use if you have a specific API identifier
AUTH0_AUDIENCE=

# Auth0 Management API - Machine-to-Machine (M2M) application credentials
# Create a separate M2M application in Auth0 Dashboard -> Applications
# and authorize it for the Auth0 Management API with required scopes.
AUTH0_MANAGEMENT_CLIENT_ID=your-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-m2m-client-secret

STRIPE_ENDPOINT_SECRET=

# SendGrid email configuration
SENDGRID_API_KEY=
SENDGRID_API_URL=https://api.sendgrid.com
SENDGRID_FROM_EMAIL=noreply@prodeko.org
