RUST_LOG=debug
DATABASE_URL=postgres://membership:secret@localhost:5433/membership?sslmode=disable
TEST_DATABASE_URL=postgres://membership:secret@localhost:5433/membership?sslmode=disable

# On linux (WSL) you can't bind to ports below 1024 without
# net_bind_service capability or root.
# Port 80 would cause tokio::net::TcpListener::bind(PORT) to fail with
# Os { code: 13, kind: PermissionDenied, message: "Permission denied" }
PORT=8080
FRONTEND_URL=http://127.0.0.1:5173

# Keycloak configuration
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=membership-registry

# OAuth2 client credentials (from the Keycloak realm client)
KEYCLOAK_CLIENT_ID=membership-registry
KEYCLOAK_CLIENT_SECRET=dev-secret-membership-registry

# OAUTH_REDIRECT_URL is the callback URL after authentication
OAUTH_REDIRECT_URL=http://127.0.0.1:5173/auth/callback

# Keycloak Admin API - service account client credentials
# This client needs "realm-management" roles for user/role CRUD.
KEYCLOAK_ADMIN_CLIENT_ID=membership-registry-m2m
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-secret-membership-registry-m2m

STRIPE_ENDPOINT_SECRET=

# Email configuration
# Dev/e2e: use Mailpit via SMTP (see docker-compose.yml — UI at http://localhost:8025).
# Prod: leave SMTP_HOST empty and set SENDGRID_API_KEY instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@prodeko.org

# SENDGRID_API_KEY=
# SENDGRID_API_URL=https://api.sendgrid.com
# SENDGRID_FROM_EMAIL=noreply@prodeko.org

# Auth rate limiting (generous defaults for dev; tighten in prod)
AUTH_RATE_LIMIT_PER_SECOND=6
AUTH_RATE_LIMIT_BURST_SIZE=10
